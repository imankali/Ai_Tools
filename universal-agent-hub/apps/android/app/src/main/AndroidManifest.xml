<?xml version="1.0" encoding="utf-8"?>
<!--
  Universal Agent Hub — Android shell manifest

  اپ یک پوسته‌ی WebView است: سرور روی کامپیوتر اجرا می‌شود و این برنامه
  فقط UI همان سرور را نمایش می‌دهد. هیچ کلید API روی گوشی ذخیره نمی‌شود؛
  تنها «آدرس سرور» و «توکن» در Keystore اندروید نگه‌داری می‌شوند.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- تماس با سرور روی شبکه‌ی محلی -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- نگهداشتن اتصال هنگام اجرای کار بلند (foreground service اختیاری است) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- اعلان تأیید درخواست‌های خطرناک -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- لرزش برای هشدارها -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.AgentHub">

        <activity
            android:name=".PairActivity"
            android:exported="true"
            android:label="@string/pair_title"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- لینک عمیق: agenthub://connect?url=http://192.168.1.10:8765&amp;token=... -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="agenthub" android:host="connect" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:exported="false"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
