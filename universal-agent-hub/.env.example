# Universal Agent Hub — نمونه تنظیمات
# کپی کنید به `.env` و مقادیر را پر کنید:  cp .env.example .env
# هیچ‌کدام از این متغیرها الزامی نیستند، ولی بدون OPENAI_API_KEY ایجنت نمی‌تواند
# به مدل وصل شود.

# ---------------------------------------------------------------------------
# OpenAI / مدل زبانی
# ---------------------------------------------------------------------------
# کلید API (یا هر سرویس سازگار با OpenAI)
OPENAI_API_KEY=sk-xxx…here
# نام مدل. توجه: `gpt-6-astra` فقط در صورتی کار می‌کند که ارائه‌دهنده‌ی شما آن را
# در OPENAI_BASE_URL ارائه دهد. اگر از api.openai.com استفاده می‌کنید یکی از
# مدل‌های واقعی (مثلاً gpt-4o-mini) را انتخاب کنید یا MODEL_FALLBACKS را پر کنید.
MODEL_NAME=gpt-6-astra
# اگر مدل اصلی موجود نبود، به ترتیب روی این مدل‌ها امتحان می‌شود (جدا شده با کاما)
MODEL_FALLBACKS=gpt-4o-mini,gpt-4o
# برای سرویس‌های سازگار با OpenAI (Ollama, vLLM, OpenRouter, Azure gateway, ...)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=http://localhost:11434/v1
TEMPERATURE=0.7
MAX_OUTPUT_TOKENS=2048
MAX_RETRIES=3
REQUEST_TIMEOUT=120
MAX_TOOL_ITERATIONS=8
# اجرای موازی فراخوانی‌های مستقل ابزار در یک نوبت
PARALLEL_TOOL_CALLS=true

# ---------------------------------------------------------------------------
# ایمنی
# ---------------------------------------------------------------------------
# تأییدی‌بودن عملیات حساس از طریق CLI
# کلید اصلی نگهبان؛ false فقط قواعد بحرانی را نگه می‌دارد (روی ماشین واقعی توصیه نمی‌شود)
ENABLE_SAFETY_GUARD=true
ENABLE_CONFIRMATION=true
# سیاست دستورهای پرخطر: confirm (تأیید بگیر) یا deny (کلاً رد کن)
DANGEROUS_COMMAND_POLICY=confirm
# اجرای /bin/sh -c فقط با true (در غیر این صورت بدون shell اجرا می‌شود)
ALLOW_SHELL=true
# سقف زمان هر دستور (ثانیه)
MAX_COMMAND_TIMEOUT=30
# دایرکتوری‌های مجاز برای ابزار فایل (خالی = فقط دایرکتوری پروژه)
ALLOWED_DIRECTORIES=./
# دسترسی کامل به فایل‌سیستم (با احتیاط! فقط روی ماشین ایزوله)
UNRESTRICTED_FILESYSTEM=false
# سقف حجم خواندن/نوشتن هر فایل (بایت) و سقف کاراکتر خروجی برای مدل
MAX_FILE_BYTES=524288
MAX_OUTPUT_CHARS=12000

# ---------------------------------------------------------------------------
# لاگ و رویدادها
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=agent.log
LOG_MAX_BYTES=2097152
LOG_BACKUP_COUNT=3
RICH_CONSOLE=true
# ثبت همه‌ی رویدادها در فایل JSONL برای ممیزی (خالی = غیرفعال)
EVENTS_LOG_FILE=
# EVENTS_LOG_FILE=agent-events.jsonl

# ---------------------------------------------------------------------------
# وب
# ---------------------------------------------------------------------------
# auto | ddgs | html | tavily | offline
SEARCH_BACKEND=auto
SEARCH_NUM_RESULTS=6
SEARCH_TIMEOUT=20
# کلید اختیاری Tavily (https://tavily.com)
TAVILY_API_KEY=
BROWSE…024]

# ---------------------------------------------------------------------------
# مرورگر (Playwright — اختیاری)
# ---------------------------------------------------------------------------
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
BROWSER_SESSION_TTL=600

# ---------------------------------------------------------------------------
# نصب
# ---------------------------------------------------------------------------
#   python -m venv .venv && source .venv/bin/activate
#   pip install -r requirements.txt
#   pip install -e .
#   playwright install chromium     # فقط اگر ابزار مرورگر را می‌خواهید
#   cp .env.example .env            # و کلید را وارد کنید
#   agent-hub

# ---------------------------------------------------------------------------
# سرور / اپ موبایل و دسکتاپ (REST + WebSocket + UI)
# ---------------------------------------------------------------------------
# روشن/خاموش‌کردن سرویس اپ (CLI: agent-hub --serve)
SERVER_ENABLED=true
# روی 127.0.0.1 فقط همین دستگاه; برای استفاده از گوشی این را روی 0.0.0.0 بگذارید
SERVER_HOST=127.0.0.1
SERVER_PORT=8765
# اگر خالی باشد، روی آدرس غیر لوپ‌بکک سرور بالا نمی‌آید (مگر با --lan که توکن می‌سازد)
SERVER_TOKEN=
# محدودساز نرخ برای مسیرهای پرهزینه (اجرای ایجنت، فراخوانی ابزار، نوشتن کلید)
SERVER_RATE_LIMIT=30
# چند ثانیه منتظر تأیید کاربر بمانیم (پیش‌فرض 15 دقیقه — موبایل ممکن است sleep باشد)
SERVER_APPROVAL_TIMEOUT=900
# عمر session بی‌استفاده (ثانیه) — پس از آن ابزارها آزاد می‌شوند
SERVER_SESSION_TTL=3600
# سقف حجم بدنه‌ی درخواست (بایت)
SERVER_MAX_BODY_BYTES=1048576
# آیا مسیر POST /api/tools/{name}/invoke باز باشد؟ (قدرت کامل ابزار از راه دور)
SERVER_ALLOW_DIRECT_TOOLS=false
# فایل پروفایل‌های کلید API (پیش‌فرض: ~/.universal-agent-hub/keys.json)
SERVER_KEYSTORE=
# پوشه‌ی UI; مقدار off یعنی فقط API سرو شود
SERVER_STATIC_DIR=

# ---------------------------------------------------------------------------
# حافظه‌ی بلندمدت ایجنت (یادداشت‌های پایدار بین اجراها)
# ---------------------------------------------------------------------------
MEMORY_ENABLED=true
# پوشه‌ی حافظه؛ پیش‌فرض ~/.universal-agent-hub/memory
MEMORY_DIR=
# پس از هر اجرا یک یادداشت خودکار ثبت شود
MEMORY_AUTO_CAPTURE=true
# سقف کاراکتر تزریق حافظه در system prompt (0 = فقط هنگام درخواست ایجنت)
MEMORY_CONTEXT_CHARS=4000
MEMORY_MAX_RECORDS=2000

# ---------------------------------------------------------------------------
# گزارش فعالیت (پنل «چه کردم و بعدی چیست» در UI و دستور --report)
# ---------------------------------------------------------------------------
# خلاصه‌ی هر اجرا (ابزارها، توکن، نتیجه، بلوک‌های ایمنی) در فایل JSONL ثبت شود
REPORTS_ENABLED=true
# مسیر فایل؛ خالی = ~/.universal-agent-hub/activity.jsonl
ACTIVITY_LOG_FILE=
# سقف رکورد اجرا در همان فایل (قدیمی‌ترین‌ها فشرده می‌شوند)
REPORT_MAX_RUNS=2000
